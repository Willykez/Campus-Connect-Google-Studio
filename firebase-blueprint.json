{
  "version": "2.0.0",
  "project": "CampusConnect",
  "description": "Firestore collection schema for user roles, document moderation, and academic content",
  "collections": {
    "user_roles": {
      "description": "User role registry tracking Admin, Lecturer, and Student privileges",
      "path": "user_roles/{userId}",
      "fields": {
        "userId": { "type": "string", "required": true, "description": "Unique identifier of the user" },
        "email": { "type": "string", "required": true, "description": "Institutional email address" },
        "fullName": { "type": "string", "required": true, "description": "Full name of the academic persona" },
        "role": { "type": "string", "required": true, "enum": ["ADMIN", "LECTURER", "STUDENT"], "description": "Assigned access role" },
        "accountStatus": { "type": "string", "required": true, "enum": ["APPROVED", "PENDING", "REJECTED", "SUSPENDED"], "description": "Account authorization status" },
        "studentOrStaffNumber": { "type": "string", "required": false, "description": "Registration or employee identification number" },
        "department": { "type": "string", "required": false, "description": "Faculty or department affiliation" },
        "assignedBy": { "type": "string", "required": false, "description": "Admin UID who granted or updated the role" },
        "createdAt": { "type": "timestamp", "required": true, "description": "Timestamp when the role record was created" },
        "updatedAt": { "type": "timestamp", "required": true, "description": "Timestamp when the record was last modified" }
      }
    },
    "documents": {
      "description": "Academic documents, materials, and attachments awaiting or granted admin approval",
      "path": "documents/{documentId}",
      "fields": {
        "id": { "type": "string", "required": true },
        "title": { "type": "string", "required": true },
        "courseCode": { "type": "string", "required": false },
        "uploaderId": { "type": "string", "required": true },
        "uploaderName": { "type": "string", "required": true },
        "uploaderRole": { "type": "string", "required": true },
        "fileName": { "type": "string", "required": true },
        "fileSize": { "type": "string", "required": true },
        "mimeType": { "type": "string", "required": true },
        "approvalStatus": { "type": "string", "required": true, "enum": ["APPROVED", "PENDING_REVIEW", "DISAPPROVED"] },
        "approvedBy": { "type": "string", "required": false },
        "approvedAt": { "type": "timestamp", "required": false },
        "createdAt": { "type": "timestamp", "required": true },
        "updatedAt": { "type": "timestamp", "required": true }
      }
    }
  }
}
