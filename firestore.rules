rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRoleData(uid) {
      return get(/databases/$(database)/documents/user_roles/$(uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
         getUserRoleData(request.auth.uid).role == "ADMIN") ||
        (request.auth.token != null && request.auth.token.role == "ADMIN")
      );
    }

    function isUploader(uploaderId) {
      return isAuthenticated() && request.auth.uid == uploaderId;
    }

    // User Roles collection:
    // Tracks Admin, Lecturer, Student roles and account statuses
    match /user_roles/{userId} {
      // Unapproved and approved users can read roles (allows public access to see campus contacts)
      allow read: if true;

      // Only Admin users can create, update, or assign roles
      allow create: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && request.resource.data.role == "STUDENT");
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Academic Documents & Study Materials collection
    match /documents/{documentId} {
      // Anyone (including unapproved users) can view approved documents
      allow read: if resource.data.approvalStatus == "APPROVED" ||
                     isAdmin() ||
                     isUploader(resource.data.uploaderId);

      // Authenticated users can upload documents
      allow create: if isAuthenticated() &&
                       request.resource.data.uploaderId == request.auth.uid &&
                       request.resource.data.approvalStatus in ["PENDING_REVIEW", "APPROVED"];

      // Only Admin can approve or disapprove documents.
      // Uploaders can edit title/content, but cannot self-approve.
      allow update: if isAdmin() || (
        isUploader(resource.data.uploaderId) &&
        request.resource.data.approvalStatus == resource.data.approvalStatus
      );

      // Admin can delete any document; uploaders can delete their own
      allow delete: if isAdmin() || isUploader(resource.data.uploaderId);
    }

    // Announcements collection
    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (getUserRoleData(request.auth.uid).role in ["LECTURER", "ADMIN"])
      );
      allow update: if isAdmin() || (
        isUploader(resource.data.authorId) &&
        request.resource.data.approvalStatus == resource.data.approvalStatus
      );
      allow delete: if isAdmin() || isUploader(resource.data.authorId);
    }

    // Coursework Submissions collection
    match /submissions/{submissionId} {
      allow read: if isAdmin() ||
                     (isAuthenticated() && (
                       request.auth.uid == resource.data.studentId ||
                       getUserRoleData(request.auth.uid).role in ["LECTURER", "ADMIN"]
                     ));
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAdmin() ||
                       (isAuthenticated() && getUserRoleData(request.auth.uid).role in ["LECTURER", "ADMIN"]) ||
                       isUploader(resource.data.studentId);
      allow delete: if isAdmin() || isUploader(resource.data.studentId);
    }
  }
}
